# Copy to local.properties (never commit it). Android Studio adds sdk.dir automatically.
# Leave the LightGrab values empty to run the app in clearly-labelled demo mode.

# Existing LightGrab backend (shared with Office and Admin). Publishable/anon key only.
SUPABASE_URL=https://YOUR-PROJECT.supabase.co
SUPABASE_PUBLISHABLE_KEY=

# Optional: push notifications (Firebase Cloud Messaging). Values from the Firebase console.
FIREBASE_APP_ID=
FIREBASE_API_KEY=
FIREBASE_PROJECT_ID=
FIREBASE_SENDER_ID=

# Optional: release signing
RELEASE_STORE_FILE=
RELEASE_STORE_PASSWORD=
RELEASE_KEY_ALIAS=
RELEASE_KEY_PASSWORD=
